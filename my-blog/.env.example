
# Primary Configuration
VITE_BASE_URL='NO TRAILING SLASH'
VITE_API_KEY=inserthere
VITE_CLIENT_ID=inserthere
VITE_CLICKINSIGHTS_DEBUG_URL='OPTIONAL URL WITH NO TRAILING SLASH'

# Firebase Configuration
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id


# Crypto
VITE_DONATION_ETH_ADDRESS=0x
VITE_DONATION_BTC_ADDRESS=insertHere

# Pipeline Audit PDF sale (see README "Pipeline Audit")
# PUBLIC_* values are inlined into the browser bundle. Never put a secret in one.
# "sepolia" (default) or "mainnet"
PUBLIC_CHAIN=sepolia
PUBLIC_RECEIVING_ADDRESS=0xYourReceivingWallet

# Server only. Read by the /api functions, never shipped to the browser.
# Must be on the same network as PUBLIC_CHAIN (eth-sepolia... or eth-mainnet...)
ALCHEMY_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-alchemy-key
ALCHEMY_WEBHOOK_SIGNING_KEY=whsec_your_webhook_signing_key
LUCIA_API_KEY=your-lucia-api-key
